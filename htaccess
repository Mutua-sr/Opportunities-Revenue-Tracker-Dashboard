# Commercial Dashboard — Apache Configuration

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# ── Explicit MIME types (critical — prevents text/html fallback) ──
AddType text/css                  .css
AddType application/javascript    .js
AddType application/json          .json
AddType image/svg+xml             .svg
AddType image/x-icon              .ico
AddType image/png                 .png
AddType image/jpeg                .jpg .jpeg
AddType application/woff2         .woff2
AddType application/font-woff     .woff

# ── Compression ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Caching ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ── Security + CORS headers ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Force correct content-type for JS and CSS (belt-and-suspenders)
    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript; charset=UTF-8"
    </FilesMatch>
    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=UTF-8"
    </FilesMatch>

    # CORS for PHP API endpoints
    <FilesMatch "\.php$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type"
    </FilesMatch>
</IfModule>

# ── Block direct access to sensitive scripts ──
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<Files "seed.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
